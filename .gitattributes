# Line endings are normalised to LF in the repository. research/docs/ is tracked
# and fully regenerated on every build, so any tool or editor that writes native
# line endings would turn a rebuild into a whitespace-only diff across ~1.5 MB.
# The build itself also pins newline="\n"; this is the second line of defence.
* text=auto eol=lf

# Provenance is kept byte-for-byte. research/raw/ is unprocessed workflow output
# and the loose .txt/.html at the root of research/ are downloaded wiki pages.
# Neither is authored here, so neither gets rewritten — several legitimately
# carry CRLF exactly as harvested.
research/raw/**  -text
research/*.txt   -text
research/*.html  -text

# The FTS index is binary. Gitignored, but declared so an accidental `git add -f`
# does not try to diff or normalise it.
*.db binary
